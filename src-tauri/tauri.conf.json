        "url": "result_display.html",
        "visible": false,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "focus": true,
        "center": false,
        "width": 560,
        "height": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; connect-src 'self' tauri://ipc; img-src 'self' data: asset: https://asset.localhost http://asset.localhost; font-src 'self'; object-src 'none';",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/image_history_blobs/**",
          "**/screenshot_boot/**"
        ]
      }
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "updater": {
      "active": true,
      "windows": {
        "installMode": "basicUi"
      },
      "endpoints": [
        "https://github.com/zRq1351/fuyun_tools/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwOTA5OEEyQjEwNDUzRDIKUldUU1V3U3hvcGlRd015QWdKYzJKRUJFLzdGRkdyRVNPV2JQWEZrN3hadUppQ3NocEc3QXRrVVkK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "models/*",
      "../LICENSE",
      "../docs/THIRD_PARTY_NOTICES.md",
      "../docs/GPLv2",
      "../docs/LGPLv2.1",
      "../docs/Apache-2.0",
      "../docs/OpenCV_LICENSE"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  }
