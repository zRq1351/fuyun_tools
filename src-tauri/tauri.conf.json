        "visible": false,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "focus": true,
        "width": 940,
        "height": 720,
        "center": true
      },
      {
        "label": "launcher",
        "title": "启动器",
        "url": "launcher.html",
        "visible": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "backgroundColor": [
          0,
